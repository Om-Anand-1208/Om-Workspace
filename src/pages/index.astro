---
import '../styles/global.css';
import '../styles/geist.css';
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add("has-welcome");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050505" />
    <meta name="description" content="Explore Om's projects and the code behind them." />
    <title>Om's Room — Projects & Experiments</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="welcome-screen" id="welcome-screen" role="status" aria-label="Hi, I’m Om Anand. Welcome to my workspace."><div class="welcome-copy" aria-hidden="true"><span class="welcome-line">Hi, I'm Om Anand.</span><span class="welcome-line welcome-line-secondary">Welcome to my workspace.</span></div></div>
    <main class="experience">
      <div class="room-viewport" id="room-viewport" aria-label="Interactive 3D room. Drag to look around and scroll to zoom."></div>
      <p class="room-status" id="room-status" role="status">Loading the room…</p>
      <p class="social-hint" id="social-hint" role="status" hidden></p>
      <button class="screen-reader-work" id="open-work" type="button">Explore projects</button>
    </main>
    <dialog class="work-dialog" id="work-dialog" aria-labelledby="work-title">
      <div class="work-shell">
        <header class="work-header"><h2 id="work-title">My Projects</h2><button type="button" class="close-work" id="close-work" aria-label="Close projects">×</button></header>
        <div class="catalogue-grid">{projects.map((project) => <a class="catalogue-card" href={`/projects/${project.slug}/`}><div class="catalogue-image"><img src={`/projects/${project.repo}.png`} alt="" loading="lazy" /></div><div class="catalogue-label"><h3>{project.title}</h3></div></a>)}</div>
      </div>
    </dialog>
    <script>import '../scripts/welcome.ts'; import '../scripts/room.ts'; import '../scripts/projects.ts';</script>
  </body>
</html>
