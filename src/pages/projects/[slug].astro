---
import '../../styles/global.css';
import '../../styles/geist.css';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const owner = project.owner ?? 'Om-Anand-1208';
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><script is:inline src="/hard-refresh.js"></script><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#0a0a0a" /><meta name="description" content={project.description} /><title>{project.title} — Om's Workspace</title><link rel="icon" type="image/png" href="/chilchuck.png?v=1" /></head>
<body class="project-page"><header class="project-top"><a href="/?work=1" class="back-link" aria-label="Back to projects"><svg class="back-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m0 0 6-6m-6 6 6 6" /></svg><span>Back</span></a><h1>{project.title}</h1><a href="/" class="room-link">Back to room <span aria-hidden="true">↗</span></a></header>
<main class="project-layout"><section class="project-copy"><p class="project-description">{project.description}</p><div class="project-stack"><p>{project.stack}</p></div><div class="project-actions"><a href={`https://github.com/${owner}/${project.repo}`} target="_blank" rel="noreferrer">View code ↗</a>{project.url && <a href={project.url} target="_blank" rel="noreferrer">Visit project ↗</a>}</div></section>
<section class="model-section" aria-label={`Preview of ${project.title}`}>
  {project.kind === 'room' ? <div id="project-model" class="room-embed"><iframe src="/?embed=1" title="Explore Om’s Room" loading="lazy"></iframe></div> : project.kind === 'image' ? <div id="project-model" class="project-original"><img src={project.cover} alt={`${project.title} project artwork`} /></div> : <div id="project-model" data-model={project.model}><img src={project.cover} alt={`Isometric model representing ${project.title}`} /></div>}
{project.gallery.length > 0 && <div class="project-gallery" aria-label={`${project.title} screenshots`}>
    {project.gallery.map(image => <a href={image.src} target="_blank" rel="noreferrer" aria-label={`Open ${image.alt}`}><img src={image.src} alt={image.alt} loading="lazy" /></a>)}
  </div>}
</section>
<section class="project-history"><h2>Recent activity<span>.</span></h2><div id="history" data-repo={project.repo} data-owner={owner} aria-live="polite"><p class="history-state">Loading commits…</p></div><a class="history-link" href={`https://github.com/${owner}/${project.repo}/commits/`} target="_blank" rel="noreferrer">Full history on GitHub ↗</a></section></main>
<script>import '../../scripts/project-page.ts';</script></body></html>
